# =============================================================================
# Polaris — Frontend Service (Vite + React → nginx)
# Build context: repo root   (used by Render — dockerfilePath: ./Dockerfile.frontend)
# For local dev use:  docker compose up --build
# =============================================================================

# ── Stage 1: Vite build ───────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /build

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Baked into the JS bundle — Render passes this via dockerBuildArgs
ARG VITE_API_URL=http://localhost:5001
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: nginx static server ──────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

RUN rm /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
